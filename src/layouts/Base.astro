---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
  description?: string | undefined;
  /** Post id, when this page is a post. Enables the Markdown alternate link. */
  markdownFor?: string | undefined;
}

const {
  title,
  description = 'Notes on C++, databases and the Linux kernel.',
  markdownFor,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500&family=Spectral:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title="Mohammed Sohail" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    {/* llms.txt discovery: the Markdown twin of this page, and the index covering it. */}
    {markdownFor && (
      <link rel="alternate" type="text/markdown" href={`/blog/${markdownFor}.md`} />
    )}
    <link rel="describedby" type="text/markdown" href="/llms.txt" />
    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
            return;
          }
        } catch (e) {}
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <header>
      <a href="/" class="home">msohail22</a>
      <nav>
        <a href="/rss.xml" class="nav-link">rss</a>
        <ThemeToggle client:idle />
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p>Mohammed Sohail &middot; <a href="https://github.com/msohail22">github</a></p>
    </footer>

    <script>
      // Give every code block a language label and a copy button.
      document.querySelectorAll<HTMLPreElement>('pre.astro-code').forEach((pre) => {
        const parent = pre.parentNode;
        if (!parent) return;

        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        parent.insertBefore(wrap, pre);

        const bar = document.createElement('div');
        bar.className = 'code-bar';

        const lang = document.createElement('span');
        lang.className = 'code-lang';
        lang.textContent = pre.dataset.language ?? 'text';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        btn.textContent = 'copy';
        btn.addEventListener('click', () => {
          const code = pre.innerText;
          const done = (label: string) => {
            btn.textContent = label;
            window.setTimeout(() => {
              btn.textContent = 'copy';
            }, 1400);
          };
          navigator.clipboard.writeText(code).then(
            () => done('copied'),
            () => {
              // Clipboard can be refused; fall back to selecting the text.
              const range = document.createRange();
              range.selectNodeContents(pre);
              const sel = window.getSelection();
              sel?.removeAllRanges();
              sel?.addRange(range);
              done('selected');
            },
          );
        });

        bar.append(lang, btn);
        wrap.append(bar, pre);
      });
    </script>
  </body>
</html>
