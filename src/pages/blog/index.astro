---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.blog === 'ready')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base title="Blog — Mohammed Sohail" description="Notes written from real patches.">
  <h1>Blog</h1>
  <p class="lede">Notes written from the real patch, never from memory.</p>

  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a class="posts__title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="posts__meta">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            </p>
            {post.data.summary && <p class="posts__summary">{post.data.summary}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>
