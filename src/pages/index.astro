---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.blog === 'ready')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Mohammed Sohail">
  <h1>Mohammed Sohail</h1>
  <p class="lede">
    I like building fast, low-level systems. Notes from ClickHouse, the Linux kernel and a homelab.
  </p>
  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a class="posts__title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="posts__meta">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              <span class="posts__topic">{post.data.topic}</span>
            </p>
            {post.data.summary && <p class="posts__summary">{post.data.summary}</p>}
            {post.data.tags.length > 0 && (
              <ul class="tags">
                {post.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
