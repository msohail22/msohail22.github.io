---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import '../styles/home.css';

const posts = (await getCollection('blog', ({ data }) => data.blog === 'ready')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

// Real, landed work only. No invented metrics, no rounded-up claims.
const ticker = [
  'Reject Arrow IPC inputs with an unsupported metadata version',
  'Fix reading flattened Nested members next to a JSON member in Wide parts',
  'Bound the search for the structure of a Freeform row',
  'Load a stored table definition that carries an inherited column TTL',
  'Add indexes aliases for settings spelled with indices',
  'staging: rtl8723bs: remove comparisons to true/false',
];

const work = [
  {
    tag: 'ClickHouse',
    title: 'Formats that refuse bad bytes',
    body:
      'Merged fixes in the Arrow, TSV and Freeform readers. A 120-byte file claimed a format version that does not exist; ClickHouse reported a schema for it. Now it refuses.',
    cls: 'bento__cell--wide',
  },
  {
    tag: 'Linux kernel',
    title: 'Patches to staging',
    body: 'checkpatch cleanups in the rtl8723bs driver, sent to Greg KH over git-send-email.',
    cls: 'bento__cell--tall',
  },
  { tag: 'LLVM', title: 'libc float128', body: 'Exponent decomposition on targets where long double is not 128-bit.', cls: '' },
  { tag: 'low-level-lab', title: 'A moderated question system', body: 'Better Auth, OpenFGA authorization boundaries, CRUD foundations.', cls: '' },
  { tag: 'Home server', title: 'Things that broke at 2am', body: 'The rollbacks are written down too.', cls: 'bento__cell--full' },
];
---

<Base title="Mohammed Sohail">
  <div class="chaos">
    <section class="hero">
      <div>
        <p class="hero__kicker">Systems engineer · C++ · databases</p>
        <h1 class="hero__title">
          <span>Mohammed</span>
          <span>Sohail</span>
          <span>builds</span>
        </h1>
        <p class="hero__lede">
          I work on the parts that are supposed to refuse bad input. ClickHouse formats,
          the Linux kernel staging tree, LLVM's libc. Notes written from the real patch,
          never from memory.
        </p>
        <a class="hero__cta" href="#writing">Read the notes &darr;</a>
      </div>

      <div class="hero__stage" id="stage">
        <canvas id="hero-canvas" aria-hidden="true"></canvas>
        <!-- Drawn, not decorative: the same icosahedron silhouette, so the slot is
             never empty while Three.js loads, fails, or is deliberately skipped. -->
        <div class="hero__fallback" aria-hidden="true">
          <svg viewBox="0 0 200 200" width="62%" fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="100" cy="100" r="78" opacity="0.35" />
            <path d="M100 22 L168 61 L168 139 L100 178 L32 139 L32 61 Z" opacity="0.7" />
            <path d="M100 22 L100 100 L168 61 M100 100 L168 139 M100 100 L100 178 M100 100 L32 139 M100 100 L32 61" opacity="0.45" />
          </svg>
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__row">
        {ticker.map((t) => <span>{t} <span style="opacity:.45">/</span></span>)}
      </div>
      <div class="marquee__row">
        {ticker.map((t) => <span>{t} <span style="opacity:.45">/</span></span>)}
      </div>
    </div>

    <section class="work">
      <p class="section-label"><span>Where the work lands</span><span>01</span></p>
      <div class="bento reveal">
        {work.map((w) => (
          <article class={`bento__cell ${w.cls}`}>
            <span class="bento__tag">{w.tag}</span>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="writing" id="writing">
      <p class="section-label"><span>Writing</span><span>02</span></p>
      {
        posts.length === 0 ? (
          <p class="feed__empty">No posts yet.</p>
        ) : (
          <ul class="feed">
            {posts.map((post) => (
              <li class="reveal">
                <a class="feed__link" href={`/blog/${post.id}/`}>
                  <time class="feed__date" datetime={post.data.date.toISOString()}>
                    {fmt(post.data.date)}
                  </time>
                  <div>
                    <h2 class="feed__title">{post.data.title}</h2>
                    {post.data.summary && <p class="feed__summary">{post.data.summary}</p>}
                    <p class="feed__meta">
                      {post.data.topic}
                      {post.data.tags.length > 0 && ` · ${post.data.tags.join(' · ')}`}
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Base>

<script>
  // Scroll reveal. Elements are styled visible by default and only hidden inside
  // a `prefers-reduced-motion: no-preference` block, so this adds polish and is
  // never load-bearing for reading the page.
  const reveals = document.querySelectorAll('.reveal');
  if (reveals.length) {
    // Only now is it safe for CSS to hide them.
    document.documentElement.dataset.reveal = '';
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).dataset.seen = '';
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    for (const el of reveals) io.observe(el);
  }

  // The 3D hero is opt-in by capability, not forced on every visitor.
  // Three.js is ~600KB; it is not worth that on a metered connection, a
  // low-core phone, or for someone who asked for less motion.
  const stage = document.getElementById('stage');
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = window.matchMedia('(max-width: 40rem)').matches;
  const weak = (navigator.hardwareConcurrency ?? 8) <= 4;
  const saveData = (navigator as any).connection?.saveData === true;

  if (canvas && stage && !reduced && !narrow && !weak && !saveData) {
    const start = () => {
      import('../scripts/iridescent-hero')
        .then(({ mountHero }) => {
          mountHero(canvas);
          stage.dataset.live = 'true';
        })
        .catch(() => {
          // Leave the SVG fallback in place and say nothing. A broken hero must
          // not look like a broken page.
        });
    };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(start, { timeout: 2500 });
    } else {
      setTimeout(start, 900);
    }
  }
</script>
